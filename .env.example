# Public Vite env — copy to .env.local and fill locally.
# Do not put secret keys here. Supabase service role stays on the server.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets. Configure as Cloudflare Worker secrets; never use VITE_ here.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_me
